# Зависимостей у бота нет — ни pip, ни apt. Это важно: из нашего ЦОДа
# закрыты и deb.debian.org, и npm, так что любая установка пакетов
# потребовала бы прокси и могла зависнуть. Здесь ставить нечего.
FROM python:3.13-slim

WORKDIR /app
COPY бот.py сезон.json ./

# логи должны идти в docker logs сразу, а не копиться в буфере
ENV PYTHONUNBUFFERED=1
# база — на смонтированном томе, чтобы пережить пересборку
ENV DB_PATH=/данные/данные.sqlite

CMD ["python3", "бот.py"]
